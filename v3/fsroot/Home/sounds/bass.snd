# A fat bass for Acid Tracker, in two halves for two tracks: a filtered
# saw, and a detuned pulse whose width sweeps while the note holds. Play
# the same notes with both (Acid Groove has them on tracks 2 and 6).
instrument fatbass
  wave saw
  adsr 2 120 60 80
  filter lp 60 res 6
  route on
  gate on
on release
  gate off
end

instrument fatpulse
  wave pulse; duty 30; fine +6
  adsr 2 120 60 80
  route on
  gate on
  loop
    duty +2
    wait 1
  end
on release
  gate off
end
